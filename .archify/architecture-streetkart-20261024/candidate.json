      "dot": "emerald",
      "title": "Client-Side Architecture",
      "items": [
        "Zero-backend static site architecture running entirely within the client browser",
        "Decoupled HTML5 views for customer discovery, vendor onboarding, and profile inspection"
      ]
    },
    {
      "dot": "cyan",
      "title": "State & Data Layer",
      "items": [
        "Structured vendor dataset in data/vendors.js with category indexing",
        "Dynamic URL search parameters (?id=...) route state into vendor-details.html",
        "Real-time category filtering and status toggle without page reloads"
      ]
    },
    {
      "dot": "orange",
      "title": "Design System & UI",
      "items": [
