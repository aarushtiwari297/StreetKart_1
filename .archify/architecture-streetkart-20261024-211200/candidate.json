  "cards": [
    {
      "dot": "emerald",
      "title": "Architecture Overview",
      "items": [
        "Zero-backend static web architecture running completely in modern client browsers",
        "Decoupled HTML5 view layer for buyer discovery, vendor onboarding, and vendor operations"
      ]
    },
    {
      "dot": "cyan",
      "title": "Data & State Management",
      "items": [
        "Structured mock vendor dataset in data/vendors.js with category indexing",
        "Dynamic URL search parameters (?id=...) route state into vendor-details.html",
        "Reactive client filtering and status toggle without page reload"
      ]
    },
    {
      "dot": "orange",
      "title": "Design System & Assets",
      "items": [
        "Centralized CSS custom properties in styles/index.css governing colors, spacing, and radius",
        "External typography stream from Google Fonts CDN (Inter & Poppins web fonts)",
        "Component utility classes for cards, badges, buttons, and toggle sliders"
      ]
    }
